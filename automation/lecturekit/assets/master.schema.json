{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LectureKit master v1",
  "type": "object",
  "required": ["meta", "context", "sources", "claims", "outcomes", "constants", "equations", "figures", "blocks", "questions", "documents", "slides", "timeline", "interactive", "policy"],
  "properties": {
    "meta": {"type": "object", "required": ["schema_version", "course", "session", "topic", "duration_minutes", "timezone", "level"], "properties": {"schema_version": {"const": 1}, "duration_minutes": {"type": "number", "exclusiveMinimum": 0}, "course": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "session": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}}},
    "context": {"type": "object", "required": ["official_syllabus", "prerequisites", "textbook_edition", "previous_teaching", "next_plan", "assessment_coverage", "destinations"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "uri", "status"]}},
    "claims": {"type": "array", "items": {"type": "object", "required": ["id", "text", "scope", "source_ids", "verification"]}},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "statement", "syllabus_mapping"]}},
    "constants": {"type": "array"},
    "equations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "latex", "symbols", "assumptions", "geometry", "steps", "units", "verification", "source_ids"]}},
    "figures": {"type": "array"},
    "blocks": {"type": "array", "minItems": 1},
    "questions": {"type": "array", "minItems": 5},
    "documents": {"type": "array", "minItems": 8, "maxItems": 8},
    "slides": {"type": "array", "minItems": 1},
    "timeline": {"type": "array", "minItems": 7},
    "interactive": {"type": "object", "required": ["enabled"]},
    "policy": {"type": "object", "required": ["public_document_purposes", "student_access", "instructor_access"]}
  },
  "$comment": "The Python validator additionally checks references, outcome coverage, sources, privacy, question stages, timing, reveal order and file integrity. Subject/visual gates remain evidence-based review."
}
